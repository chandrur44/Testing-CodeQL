# Intentional bait Dockerfile. Used to verify the Trivy Dockerfile
# scanner is reporting findings under the "Trivy Dockerfile Scanner"
# tool label in the Security tab. NOT used by the application.

FROM ubuntu:18.04

RUN apt-get update && apt-get install -y curl

ADD https://example.com/installer.sh /tmp/installer.sh
RUN sh /tmp/installer.sh

ENV DB_PASSWORD=hunter2

EXPOSE 22

CMD ["bash"]
